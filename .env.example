# Copy to .env for local testing (`.env` is gitignored). Bun auto-loads .env.
# All vars have sensible defaults; none are strictly required, but the default network-subgraph URL
# only resolves inside the cluster — set NETWORK_SUBGRAPH_URL to test locally.

# The Graph network subgraph GraphQL endpoint (source of all on-chain economics).
# NETWORK_SUBGRAPH_URL=https://gateway.thegraph.com/api/<KEY>/subgraphs/id/QmT329Bej8AwSLahmgnmi6fdYkj3rorYAcCes45gDv9aJ4

# Indexers to track — comma-separated wallets. Default: our indexer. Add more to observe a fleet;
# each wallet gets full stake + allocation + signal metrics.
# INDEXERS=0x3717cef8020bddee7a18f4efb2bfa88fefdcb1bc

# REFRESH_SECONDS=60          # stake/allocation/signal poll interval
# NAME_REFRESH_SECONDS=1800   # subgraph display-name poll interval (names change rarely)
# PORT=9400
